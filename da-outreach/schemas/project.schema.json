{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "Proyecto (DA) — formato estándar agente ↔ CRM ↔ Kairon",
  "type": "object",
  "required": ["da", "project", "address", "companies", "people"],
  "additionalProperties": false,
  "properties": {
    "da": { "type": "string", "minLength": 1 },
    "council": { "type": "string" },
    "project": { "type": "string", "minLength": 1 },
    "address": { "type": "string", "minLength": 1 },
    "units": { "type": ["integer", "null"], "minimum": 0 },
    "decision": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string" },
        "date": { "type": ["string", "null"], "format": "date" }
      }
    },
    "da_url": { "type": ["string", "null"], "format": "uri" },
    "companies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "confidence"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "domain": { "type": ["string", "null"] },
          "website": { "type": ["string", "null"] },
          "linkedin": { "type": ["string", "null"] },
          "confidence": { "enum": ["confirmed", "inferred"] },
          "why": { "type": ["string", "null"] },
          "source": { "type": ["string", "null"] }
        },
        "if": { "properties": { "confidence": { "const": "inferred" } } },
        "then": { "required": ["why"], "properties": { "why": { "type": "string", "minLength": 1 } } }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["first_name", "company", "confidence"],
        "additionalProperties": false,
        "properties": {
          "first_name": { "type": "string", "minLength": 1 },
          "last_name": { "type": ["string", "null"] },
          "company": { "type": "string", "minLength": 1 },
          "title": { "type": ["string", "null"] },
          "role_on_deal": { "type": ["string", "null"], "maxLength": 80 },
          "linkedin": { "type": ["string", "null"] },
          "email": { "type": ["string", "null"] },
          "phone": { "type": ["string", "null"] },
          "kairon_lead_id": { "type": ["string", "null"], "pattern": "^lead_" },
          "confidence": { "enum": ["confirmed", "inferred"] },
          "why": { "type": ["string", "null"] },
          "source": { "type": ["string", "null"] }
        },
        "if": { "properties": { "confidence": { "const": "inferred" } } },
        "then": { "required": ["why"], "properties": { "why": { "type": "string", "minLength": 1 } } }
      }
    },
    "whos_who": { "type": "string" }
  }
}
